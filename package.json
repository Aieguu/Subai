{
  "name": "subai-hugo-theme",
  "version": "2.0.0",
  "description": "一个简洁现代的 Hugo 主题",
  "scripts": {
    "dev": "hugo server -D --source exampleSite --themesDir ../..",
    "serve": "hugo server -D --source exampleSite --themesDir ../.. --bind 0.0.0.0 --port 1313",
    "build": "hugo --minify --source exampleSite --themesDir ../..",
    "build:production": "hugo --minify --gc --source exampleSite --themesDir ../..",
    "build:drafts": "hugo --minify --buildDrafts --source exampleSite --themesDir ../.."
  },
  "keywords": [
    "hugo",
    "theme",
    "blog",
    "responsive",
    "dark-mode",
    "modern",
    "minimal",
    "fast",
    "accessible",
    "seo",
    "chinese",
    "static-site",
    "jamstack"
  ],
  "author": {
    "name": "Aieguu",
    "url": "https://github.com/Aieguu"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aieguu/Subai.git"
  },
  "bugs": {
    "url": "https://github.com/Aieguu/Subai/issues"
  },
  "homepage": "https://github.com/Aieguu/Subai#readme",
  "files": [
    "assets/",
    "layouts/",
    "static/",
    "exampleSite/",
    "theme.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
